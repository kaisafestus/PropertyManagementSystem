model Organization {
  id                  String   @id @default(cuid())

  name                String
  email               String?  @unique
  phone               String?
  website             String?
  logo                String?

  automaticPublishing Boolean @default(false)
  active              Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  properties          Property[]

  @@map("organizations")
}
